generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RelationshipStatus {
  ACTIVE
  ENDED
}

enum RelationshipInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  nickname     String    @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  birthDate    DateTime? @db.Date

  /*
   * Дата подтверждения email.
   *
   * null означает, что адрес
   * ещё не подтверждён.
   */
  emailVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sentRelationshipInvitations     RelationshipInvitation[] @relation("SentRelationshipInvitations")
  receivedRelationshipInvitations RelationshipInvitation[] @relation("ReceivedRelationshipInvitations")

  relationshipsAsUser1 Relationship[] @relation("RelationshipUser1")
  relationshipsAsUser2 Relationship[] @relation("RelationshipUser2")

  createdCalendarEvents CalendarEvent[] @relation("CalendarEventCreator")

  wishlists Wishlist[]

  /*
   * Фотографии пользователя
   * на доске дня.
   */
  dayBoardEntries DayBoardEntry[] @relation("DayBoardEntryAuthor")

  /*
   * Текущий токен подтверждения email.
   *
   * Для одного пользователя одновременно
   * существует максимум один актуальный токен.
   */
  emailVerificationToken EmailVerificationToken?

  /*
   * Текущий токен восстановления пароля.
   */
  passwordResetToken PasswordResetToken?
}

/*
 * ---------------------------------------------------------
 * Подтверждение email
 * ---------------------------------------------------------
 *
 * В базе никогда не храним исходный токен,
 * отправленный пользователю.
 *
 * Храним только SHA-256 хэш.
 */
model EmailVerificationToken {
  id String @id @default(uuid())

  /*
   * Один действующий токен
   * подтверждения на пользователя.
   */
  userId String @unique

  /*
   * SHA-256 хэш случайного токена.
   */
  tokenHash String @unique

  /*
   * После этой даты ссылка
   * становится недействительной.
   */
  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/*
 * ---------------------------------------------------------
 * Восстановление пароля
 * ---------------------------------------------------------
 *
 * Здесь применяется та же схема:
 * пользователю отправляется исходный токен,
 * а в PostgreSQL сохраняется только его хэш.
 */
model PasswordResetToken {
  id String @id @default(uuid())

  /*
   * Одновременно существует максимум
   * один актуальный reset-токен
   * для конкретного пользователя.
   */
  userId String @unique

  /*
   * SHA-256 хэш исходного токена.
   */
  tokenHash String @unique

  /*
   * Срок действия ссылки
   * восстановления пароля.
   */
  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model RelationshipInvitation {
  id String @id @default(uuid())

  senderId   String
  receiverId String

  status RelationshipInvitationStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  sender   User @relation(name: "SentRelationshipInvitations", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation(name: "ReceivedRelationshipInvitations", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, status])
  @@index([receiverId, status])
}

model Relationship {
  id String @id @default(uuid())

  user1Id String
  user2Id String

  status RelationshipStatus @default(ACTIVE)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1 User @relation(name: "RelationshipUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation(name: "RelationshipUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  calendarEvents CalendarEvent[]

  /*
   * Общая история доски дня
   * для этой пары.
   */
  dayBoardEntries DayBoardEntry[]

  @@index([user1Id, status])
  @@index([user2Id, status])
}

model CalendarEvent {
  id String @id @default(uuid())

  relationshipId String
  createdById    String

  title       String
  description String?
  location    String?

  startsAt DateTime
  endsAt   DateTime?

  allDay Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relationship Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(name: "CalendarEventCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([relationshipId, startsAt])
  @@index([createdById])
}

model Wishlist {
  id String @id @default(uuid())

  ownerId String

  title       String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  items WishlistItem[]

  @@index([ownerId])
}

model WishlistItem {
  id String @id @default(uuid())

  wishlistId String

  title       String
  description String?

  url      String?
  imageUrl String?

  price Int?

  /*
   * Насколько сильно пользователь
   * хочет это желание.
   *
   * 1 - небольшой интерес
   * 5 - мечта
   *
   * Старые желания после миграции
   * автоматически получают 3.
   */
  priority Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@index([wishlistId])
}

/*
 * Одна фотография от каждого
 * участника пары на один календарный день.
 *
 * imageUrl — полноразмерная оптимизированная версия.
 * thumbnailUrl — облегчённая версия для главной
 * страницы и будущего мобильного виджета.
 */
model DayBoardEntry {
  id String @id @default(uuid())

  relationshipId String
  authorId       String

  boardDate DateTime @db.Date

  imageUrl     String
  thumbnailUrl String
  caption      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relationship Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  author       User         @relation(name: "DayBoardEntryAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([relationshipId, authorId, boardDate])
  @@index([relationshipId, boardDate])
  @@index([authorId, boardDate])
}